# ------------------------------------
# 全zshセッション用環境変数 (対話的・非対話的セッション両方)
# ------------------------------------
# 以下の場面で利用可能なパスを定義:
# - 対話的シェル (ターミナル使用時)
# - 非対話的シェル (スクリプト実行、CI/CD)
# - package.jsonスクリプト実行
# - バックグラウンドプロセス

# JavaScript ツールチェーン管理 (mise)
# mise manages Node.js/pnpm versions with automatic switching

export CMUX_CUSTOM_CLAUDE_PATH="$HOME/.local/bin/claude"

# Claude Code native インストール（実体は ~/.local/bin/claude）を全セッションで PATH からも解決できるようにする
# .zshenv に置く理由: 対話的・非対話的（スクリプト・CI/CD・cmux 以外の起動）を問わず有効にするため
# ガードの理由: .zshenv はネストした zsh でも都度読まれるので、素の prepend だと PATH に重複が積み上がる
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Google Cloud CLI は公式 archive から導入する（Homebrew の cask は使わない）
# 実体は .chezmoiscripts/run_after_90-gcloud-install.sh が展開する。更新は gcloud components update が担う。
# .zshenv に置く理由と重複ガードの理由は上の ~/.local/bin と同じ。補完は .zshrc の compinit 後で読む。
# ここでの prepend は「PATH から解決できること」しか保証しない。ログインシェルでは、この後に走る
# /etc/zprofile の path_helper が /etc/paths の中身を全部先頭へ移すため、実際の順位は後ろへ下がる。
# /opt/homebrew/bin に gcloud 系のコマンドが無い前提で成り立っている。cask を戻すと無言で先を越される。
export GCLOUD_SDK_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/google-cloud-sdk"
case ":$PATH:" in
  *":$GCLOUD_SDK_ROOT/bin:"*) ;;
  *) export PATH="$GCLOUD_SDK_ROOT/bin:$PATH" ;;
esac

# brew bundle --global の対象を ~/.Brewfile に固定（Homebrew 6 は ~/.homebrew/Brewfile を優先するため）
# （.chezmoiscripts/run_onchange_after_10-brew-bundle.sh.tmpl 内の同名 export と同期を保つ）
export HOMEBREW_BUNDLE_FILE_GLOBAL="$HOME/.Brewfile"

# homebrew-core の bottle のビルド来歴（provenance attestation）を gh で検証してからインストールする
# 対象は core formula の新規ダウンロードのみ（cask は対象外）。オフライン時は新規インストールが失敗する点に注意
export HOMEBREW_VERIFY_ATTESTATIONS=1

# lazygit の設定ファイルを XDG パスに固定する（macOS の既定は ~/Library/Application Support/lazygit で、~/.config は読まれない）
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

# 1Password CLI のデスクトップアプリ統合を有効にする
# アプリの 設定 > 開発者 で「1Password CLI と連携」にチェックが入っていても、この変数が未設定だと op が統合を認識せず `No accounts configured for use with 1Password CLI` で失敗する
# .zshenv に置く理由: 対話シェルからもスクリプト（chezmoi apply のテンプレート注入など）からも op を使うため
# 明示する理由: op は Homebrew cask、1Password アプリは自前の自動更新で独立に上がるため、明示しないとバージョンの組み合わせが変わるたびに再発しうる
export OP_BIOMETRIC_UNLOCK_ENABLED=true

{{- $client := dict }}
{{- if hasKey . "clientSecretsLedger" }}{{ $client = .clientSecretsLedger }}{{ end }}
{{- $ledger := merge (dict) .secretsLedger $client }}
{{- $names := list }}
{{- range $prof, $svcs := $ledger }}{{ range $svc, $s := $svcs }}{{ range $s.vars }}{{ $names = append $names .name }}{{ end }}{{ end }}{{ end }}
{{- $names = concat $names (list "FIRECRAWL_API_KEY" "GEMINI_API_KEY") | uniq | sortAlpha }}

# Claude Code のエージェントシェル無害化（2026-08-30 API キー露出インシデント対応）
# Claude Code の Bash ツールが起動する zsh には CLAUDECODE=1 が継承される。
# .zshenv は対話・非対話（zsh -c）を問わず読み込まれ、.zshrc の mise activate より先に評価される。
# したがってこのガードが守るのは「claude 親プロセスから継承した変数」であり、
# mise 設定に秘密が残っていれば後続の mise activate が再注入する（秘密台帳への一元化が前提）。
# unset のリストは dotfiles の秘密台帳（secretsLedger + clientSecretsLedger）から生成される。
# 注意: .zshenv.zwc が本ファイルより新しいとコンパイル済みが優先される。apply 後は .zwc を削除・再生成する。
if [[ -n ${CLAUDECODE:-} ]]; then
  # zsh の MULTIOS はパイプ併用時に `2>&1 >/dev/null` の stdout をパイプへ tee する（露出事故の直接原因）
  setopt no_multios
{{- range $names }}
  unset {{ . }} 2>/dev/null
{{- end }}
fi
