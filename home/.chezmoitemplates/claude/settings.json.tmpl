      "Bash(docker compose *)",
      "Bash(docker inspect *)",
      "Bash(colima status)",
      "Bash(colima start)",
      "Bash(colima stop)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(export -p)",
      "Bash(printenv *)",
      "Bash(mise env*)",
      "Read(~/.config/secrets/**)",
      "Bash(cat ~/.config/secrets/**)",
