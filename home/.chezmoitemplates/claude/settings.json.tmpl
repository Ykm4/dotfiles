      "Bash(grep * ~/.config/secrets/**)",
      "Bash(rg * ~/.config/secrets/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.aws/**)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat ~/.config/gh/hosts.yml)",
      "Bash(cat ~/.docker/config.json)",
      "Bash(cat ~/.gnupg/**)",
      "Bash(cat ~/.kube/**)",
      "Bash(cat ~/.netrc)",
      "Bash(cat ~/.npmrc)",
      "Bash(cat ~/.pypirc)",
      "Bash(cat ~/.ssh/**)",
      "Bash(bat ~/.aws/**)",
      "Bash(bat ~/.ssh/**)",
      "Bash(grep * .env*)",
      "Bash(grep * ~/.aws/**)",
      "Bash(grep * ~/.ssh/**)",
      "Bash(rg * .env*)",
      "Bash(rg * ~/.aws/**)",
      "Bash(rg * ~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
