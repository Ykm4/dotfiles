        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "language": "Japanese",
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowUnixSockets": [
        "/Users/ykm4/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/work/",
        "~/other/",
        "~/.config/gws/",
        "~/.config/gh/",
        "~/.config/gcloud/",
        "~/.config/gemini/",
        "~/.config/claude/_private/",
        "~/.local/share/",
        "~/.local/state/",
        "~/.cache/",
        "~/.npm/",
        "~/.bun/",
        "~/.codex/",
        "~/Library/Caches/",
        "~/Library/pnpm/",
        "/private/tmp/",
        "/tmp/"
