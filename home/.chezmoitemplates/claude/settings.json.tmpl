      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr merge *)",
