{{- $client := dict -}}
{{- if hasKey . "clientSecretsLedger" }}{{ $client = .clientSecretsLedger }}{{ end -}}
{{- $ledger := merge (dict) .secretsLedger $client -}}
{{- $names := list -}}
{{- range $prof, $svcs := $ledger }}{{ range $svc, $s := $svcs }}{{ range $s.vars }}{{ $names = append $names .name }}{{ end }}{{ end }}{{ end -}}
{{- $names = concat $names (list "FIRECRAWL_API_KEY" "GEMINI_API_KEY") | uniq | sortAlpha -}}
{{- $helperEntry := index (index $ledger "hucom-system") "context7" -}}
{{- $bearerEntry := index (index $ledger "hucom-system") "firecrawl" -}}
#!/bin/zsh
#MISE description="秘密の漏れ経路が閉じているかを値を表示せずに検査する（sentinel 監査）"
# 生成物: 編集しない。正本は dotfiles の executable_secrets-audit.tmpl と秘密台帳。
# 出力は「検査名: OK/NG」だけで、値そのものは絶対に印字しない。
#
# 自動化していない検査（手動チェックリスト）:
# - Claude Code セッション内の Bash 環境: 台帳の変数名が set されていないことを
#   「有無だけ」を出す形で確認する（env・printenv・export -p やシェルのトレース機能は使わない）。
#   例: for v in <変数名>; do (( ${(P)+v} )) && echo "$v: present" || echo "$v: absent"; done
# - hook 環境と stdio MCP 環境: 偽値（SENTINEL_ プレフィックス）で有無だけを返す
#   一時 hook / 一時 MCP を使い、値や環境全体を返さないこと。
# - sandbox 有効化後は credentials.envVars の deny と
#   CLAUDE_CODE_SUBPROCESS_ENV_SCRUB の挙動を別々に確認する。

umask 077

mise_bin='{{ lookPath "mise" | default "/opt/homebrew/bin/mise" }}'
jq_bin='{{ lookPath "jq" | default "/opt/homebrew/bin/jq" }}'
headers_helper='{{ .chezmoi.homeDir }}/.config/secrets/claude/helpers/hucom-system-context7.sh'
helper_var_name='{{ $helperEntry.header.var }}'
helper_header_name='{{ $helperEntry.header.name }}'
helper_value_mode='raw'
bearer_helper='{{ .chezmoi.homeDir }}/.config/secrets/claude/helpers/hucom-system-firecrawl.sh'
bearer_var_name='{{ $bearerEntry.header.var }}'
bearer_header_name='{{ $bearerEntry.header.name }}'

typeset -a ledger_names
ledger_names=(
{{- range $names }}
  {{ . }}
{{- end }}
)

typeset -a secret_files
secret_files=(
{{- range $prof, $svcs := $ledger }}
  '{{ $.chezmoi.homeDir }}/.config/secrets/claude/{{ $prof }}.env'
{{- end }}
)

integer failures=0
integer inputs_ok=1

report() {
  if (( $2 == 0 )); then
    print -r -- "$1: OK"
  else
    print -r -- "$1: NG"
    (( failures++ ))
  fi
}

tmp_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/secret-sentinel.XXXXXX" 2>/dev/null)
if [[ -z "$tmp_dir" || ! -d "$tmp_dir" ]]; then
  report mise_env 1
  report interactive_shell_env 1
  report secret_file_permissions 1
  report headers_helper_json 1
  exit 1
fi

/bin/chmod 700 "$tmp_dir" 2>/dev/null || inputs_ok=0

ledger_clean="$tmp_dir/ledger.names"
fake_secret_file="$tmp_dir/helper.env"

cleanup() {
  /bin/rm -f "$ledger_clean" "$fake_secret_file" 2>/dev/null
  /bin/rmdir "$tmp_dir" 2>/dev/null
}
trap cleanup EXIT HUP INT TERM

: > "$ledger_clean" || inputs_ok=0
/bin/chmod 600 "$ledger_clean" 2>/dev/null || inputs_ok=0

# 代入行だけに一致させる（^VAR=）。固定文字列だと FIRECRAWL_KEY_VAR のような
# 「値が変数名そのもの」の正当な行（例: FIRECRAWL_KEY_VAR=FIRECRAWL_API_KEY_...）に誤検知する。
for name in "${ledger_names[@]}"; do
  print -r -- "^(export )?${name}=" >> "$ledger_clean" || inputs_ok=0
done

(( ${#ledger_names[@]} > 0 )) || inputs_ok=0

# 検査プロセス自身が継承した変数を先に消す。新シェル検査が「起動設定による再導入」
# だけを検出するようにするため（呼び出し元シェルからの継承と区別する）。
for name in "${ledger_names[@]}"; do
  unset "$name" 2>/dev/null
done

# 検査1: mise env の出力に台帳の変数名が現れないこと。
mise_result=1

if (( inputs_ok == 1 )) &&
   [[ "$mise_bin" == /* && -x "$mise_bin" ]]; then
  "$mise_bin" env 2>/dev/null |
    /usr/bin/grep -E -f "$ledger_clean" >/dev/null
  # pipestatus はパイプラインの直後に捕捉する（typeset 等を挟むと上書きされる）
  mise_status=("${pipestatus[@]}")

  # mise は成功し、grep は不一致（exit 1）であること。
  if (( mise_status[1] == 0 && mise_status[2] == 1 )); then
    mise_result=0
  fi
fi

report mise_env "$mise_result"

# 検査2: まっさらに起動した login+interactive zsh が .zprofile / .zshrc / mise activate
# 経由で台帳の変数を再導入しないこと。
shell_result=1
typeset -a clean_env
clean_env=(/usr/bin/env -u CLAUDECODE)

for name in "${ledger_names[@]}"; do
  clean_env+=(-u "$name")
done

if (( inputs_ok == 1 )); then
  "${clean_env[@]}" /bin/zsh -lic '/usr/bin/env' 2>/dev/null |
    /usr/bin/grep -E -f "$ledger_clean" >/dev/null
  # pipestatus はパイプラインの直後に捕捉する（typeset 等を挟むと上書きされる）
  shell_status=("${pipestatus[@]}")

  if (( shell_status[1] == 0 && shell_status[2] == 1 )); then
    shell_result=0
  fi
fi

report interactive_shell_env "$shell_result"

# 検査3: 配備済みの秘密ファイルがシンボリックリンクでない通常ファイルで 0600 であること。
permission_result=0

(( ${#secret_files[@]} > 0 )) || permission_result=1

for secret_file in "${secret_files[@]}"; do
  if [[ ! -f "$secret_file" || -L "$secret_file" ]]; then
    permission_result=1
    continue
  fi

  file_mode=$(/usr/bin/stat -f '%Lp' "$secret_file" 2>/dev/null)
  if [[ $? -ne 0 || "$file_mode" != 600 ]]; then
    permission_result=1
  fi
done

report secret_file_permissions "$permission_result"

# 検査4: headersHelper を偽値ファイル（0600）で起動し、正しい JSON を返すこと。
helper_result=1
sentinel='SENTINEL_TEST_XXXX'

if [[ -n "$helper_header_name" &&
      ( "$helper_value_mode" == bearer || "$helper_value_mode" == raw ) &&
      "$headers_helper" == /* &&
      -x "$headers_helper" &&
      "$jq_bin" == /* &&
      -x "$jq_bin" ]]; then

  print -r -- "${helper_var_name}=${sentinel}" > "$fake_secret_file"
  fake_write_status=$?
  /bin/chmod 600 "$fake_secret_file" 2>/dev/null
  fake_chmod_status=$?

  if (( fake_write_status == 0 && fake_chmod_status == 0 )); then
    helper_json=$(
      "$headers_helper" --test-file "$fake_secret_file" 2>/dev/null
    )
    helper_status=$?

    if [[ "$helper_value_mode" == bearer ]]; then
      expected_header_value="Bearer $sentinel"
    else
      expected_header_value=$sentinel
    fi

    if (( helper_status == 0 )); then
      print -rn -- "$helper_json" |
        "$jq_bin" -e -s \
          --arg header "$helper_header_name" \
          --arg expected "$expected_header_value" \
          'length == 1 and
           (.[0] |
             (type == "object") and
             (length == 1) and
             (.[$header] == $expected))' \
          >/dev/null 2>/dev/null

      if (( pipestatus[2] == 0 )); then
        helper_result=0
      fi
    fi
  fi
fi

unset helper_json expected_header_value
report headers_helper_json "$helper_result"

# 検査5: Bearer 分岐の headersHelper も偽値で確認する（検査4は raw 分岐のみのため）。
bearer_result=1

if [[ "$bearer_helper" == /* && -x "$bearer_helper" && -n "$bearer_header_name" ]]; then
  print -r -- "${bearer_var_name}=${sentinel}" > "$fake_secret_file"
  bearer_write_status=$?
  /bin/chmod 600 "$fake_secret_file" 2>/dev/null
  bearer_chmod_status=$?

  if (( bearer_write_status == 0 && bearer_chmod_status == 0 )); then
    bearer_json=$(
      "$bearer_helper" --test-file "$fake_secret_file" 2>/dev/null
    )
    bearer_status=$?

    if (( bearer_status == 0 )); then
      print -rn -- "$bearer_json" |
        "$jq_bin" -e -s \
          --arg header "$bearer_header_name" \
          --arg expected "Bearer $sentinel" \
          'length == 1 and
           (.[0] |
             (type == "object") and
             (length == 1) and
             (.[$header] == $expected))' \
          >/dev/null 2>/dev/null

      if (( pipestatus[2] == 0 )); then
        bearer_result=0
      fi
    fi
  fi
fi

unset bearer_json sentinel
report headers_helper_bearer_json "$bearer_result"

(( failures == 0 ))
