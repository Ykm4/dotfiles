{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Skill(agent-browser)",
      "Bash(npx agent-browser *)",
      "Bash(agent-browser *)",
      "Skill(cmux-browser)",
      "Bash(cmux browser *)",
      "Skill(find-skills)",
      "Bash(npx skills *)",
      "Skill(mf-expense)",
      "Skill(agents-sdk)",
      "Skill(durable-objects)",
      "Skill(ghostty-theme)",
      "Skill(mermaid-diagrams)",
      "Skill(recover)",
      "Skill(self-review)",
      "Skill(skill-creator)",
      "Skill(skill-lint)",
      "Skill(stack-guide-ts)",
      "Skill(wrangler)",
      "Bash(skills *)",
      "mcp__context7",
      "mcp__ide__getDiagnostics",
      "mcp__plugin_slack_slack",
      "WebSearch",
      "Bash(mkdir *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(gh api *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(brew *)",
      "Bash(hono *)",
      "Bash(mise *)",
      "Bash(node -e *)",
      "Bash(docker compose *)",
      "Bash(docker inspect *)",
      "Bash(colima status)",
      "Bash(colima start)",
      "Bash(colima stop)",
      "Edit(~/.zshrc)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(export -p)",
      "Bash(printenv *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.env.*)",
      "Read(~/.aws/**)",
      "Bash(cat .env*)",
      "Bash(cat ~/.zshrc)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat ~/.config/gh/hosts.yml)",
      "Bash(cat ~/.docker/config.json)",
      "Bash(cat ~/.gnupg/**)",
      "Bash(cat ~/.kube/**)",
      "Bash(cat ~/.netrc)",
      "Bash(cat ~/.npmrc)",
      "Bash(cat ~/.pypirc)",
      "Bash(cat ~/.ssh/**)",
      "Bash(bat ~/.aws/**)",
      "Bash(bat ~/.ssh/**)",
      "Bash(grep * .env*)",
      "Bash(grep * ~/.zshrc)",
      "Bash(grep * ~/.aws/**)",
      "Bash(grep * ~/.ssh/**)",
      "Bash(rg * .env*)",
      "Bash(rg * ~/.zshrc)",
      "Bash(rg * ~/.aws/**)",
      "Bash(rg * ~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Bash(find * -exec *)",
      "Bash(find * -delete *)",
      "Bash(find * -execdir *)",
      "Bash(git -C *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(gh pr merge *)",
      "Bash(gh pr merge)",
      "Bash(gh api *merge*)"
    ],
    "ask": [
      "Bash(agent-browser set credentials *)",
      "Bash(docker compose exec *)",
      "Bash(brew services stop *)",
      "Bash(brew services restart *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/",
      "~/.config/mise/"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/cmux-notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/cmux-notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun run ~/.claude/statusline.ts",
    "padding": 2
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "minimumVersion": "2.1.76",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
