#!/usr/bin/env bash
#MISE description="pre-commit の git フックを各リポジトリが mise で解決する版で入れ直し、どのフックからも参照されなくなった展開物（~/.cache/pre-commit-zipapp）と hook 環境（pre-commit gc）を削除する"
#MISE wait_for=["tools:updaters", "mise:prune"]
# mise の pre-commit は zipapp（.pyz）で、初回の実行時に ~/.cache/pre-commit-zipapp/<キャッシュキー> へ展開される。
# pre-commit install はフックの INSTALL_PYTHON にその展開先の python を書き込む。
# そのため mise で pre-commit を上げてもフックは旧版で動き続け、旧版の展開物も残り続ける（2026-09-17 と 2026-10-18 に確認）。
#
# 対象のリポジトリは、pre-commit が install とフックの実行のたびに記録する設定ファイルの一覧（db.db の configs 表）から取る。
# pre-commit gc も同じ一覧で使用中の hook 環境を判定しているので、ディレクトリを走査するより漏れが少ない。
# 展開物は、見つけたフックのどれからも参照されていないものだけを削除する。
# 付け替えられなかったフックが参照する展開物は残すので、フックの実行先が消えることはない。
# 一覧に載っていないリポジトリのフックが参照していた展開物は消えうるが、そのフックは PATH 上の pre-commit で動く（pre-commit が生成するフックの既定の動作）。
# どの結果でも終了コードは 0 にし、問題は「警告:」で始まる出力で知らせる。
# 掃除だけのタスクの失敗で、同じ段で動く brew:cleanup などを止めないためである。
#
# wait_for: mise:prune の後に動かし、削除されずに残った版でフックを入れ直す。
# 並走させると、解決した版を mise:prune が削除しうる。
set -uo pipefail

warn() {
  echo "警告: $*" >&2
}

# zipapp の __main__.py が展開先を ~/.cache/pre-commit-zipapp に固定している（XDG_CACHE_HOME を見ない）。
zipapp_root="${HOME}/.cache/pre-commit-zipapp"
# 利用記録の置き場は pre-commit の store.py の _get_default_directory と同じ規則で決める。
store="${PRE_COMMIT_HOME:-${XDG_CACHE_HOME:-${HOME}/.cache}/pre-commit}"
db="${store}/db.db"

if [ ! -f "${db}" ]; then
  echo "pre-commit の利用記録（${db}）が無いので、何もしない。"
  exit 0
fi
if ! configs="$(sqlite3 -readonly "${db}" 'SELECT path FROM configs')"; then
  warn "pre-commit の利用記録（${db}）を読めなかった。フックにも展開物にも触れずに終える。"
  exit 0
fi

# bash 3.2 でも動くよう、集合は改行区切りの文字列で持つ。
seen_hook_dirs=""
found_hooks=""
gc_bin=""
skipped=0

# 設定ファイルのある場所から、入れ直しに使う作業ツリーを決める。
# worktree は本体と hooks を共有するので、mise の解決は本体の作業ツリーで行い、worktree ごとの設定の違いに左右されないようにする。
# 本体が bare のときは、設定ファイルのある作業ツリーを使う。
pick_workdir() {
  local dir="$1" main
  main="$(git -C "${dir}" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')"
  if [ -n "${main}" ] && [ "$(git -C "${main}" rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]; then
    printf '%s\n' "${main}"
  else
    git -C "${dir}" rev-parse --show-toplevel
  fi
}

# 一覧は fd 3 から読む。ループの中の git・mise・pre-commit が標準入力を読んで、一覧の残りを食べないようにするためである。
while IFS= read -r cfg <&3; do
  # 消えた設定ファイルは、後で実行する pre-commit gc が一覧から外す。
  [ -n "${cfg}" ] && [ -f "${cfg}" ] || continue
  dir="$(dirname "${cfg}")"
  # git の管理外になった場所にはフックが無い。
  common="$(git -C "${dir}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || continue
  hooks_dir="${common}/hooks"
  [ -d "${hooks_dir}" ] || continue
  if printf '%s' "${seen_hook_dirs}" | grep -Fxq -- "${hooks_dir}"; then
    continue
  fi
  seen_hook_dirs+="${hooks_dir}"$'\n'

  if ! workdir="$(pick_workdir "${dir}")"; then
    warn "${dir} の作業ツリーを特定できなかった。${hooks_dir} のフックは付け替えない。"
    skipped=1
  fi

  bin=""
  for hook in "${hooks_dir}"/*; do
    [ -f "${hook}" ] || continue
    case "${hook}" in
      *.sample | *.legacy) continue ;;
    esac
    grep -q '^# File generated by pre-commit' "${hook}" || continue
    found_hooks+="${hook}"$'\n'

    py="$(sed -n 's/^INSTALL_PYTHON=//p' "${hook}")"
    # pip や Homebrew の pre-commit で入れたフックには触れない。
    case "${py}" in
      "${zipapp_root}"/*) ;;
      *) continue ;;
    esac
    [ "${skipped}" -eq 0 ] || continue

    if [ -z "${bin}" ]; then
      # mise which は未インストールの版を入れないので、この段で別のツールの導入が始まることはない。
      if ! bin="$(mise -C "${workdir}" which pre-commit 2>/dev/null)"; then
        echo "${workdir}: mise で pre-commit を解決できないので、フックを付け替えない（参照している展開物は残す）。"
        echo "  使わないリポジトリなら、そこで ${py} -mpre_commit uninstall を実行してフックを外す。"
        skipped=1
        continue
      fi
      if ! want="$("${bin}" --version 2>/dev/null)" || [ -z "${want}" ]; then
        warn "${bin} の版を取得できなかった。${workdir} のフックは付け替えない。"
        skipped=1
        continue
      fi
    fi

    have=""
    [ -x "${py}" ] && have="$("${py}" -mpre_commit --version 2>/dev/null)"
    name="$(basename "${hook}")"
    if [ -n "${have}" ] && [ "${have}" = "${want}" ]; then
      echo "${workdir}: ${name} は ${want} のまま。"
      gc_bin="${bin}"
      continue
    fi

    args_line="$(sed -n 's/^ARGS=//p' "${hook}")"
    # pre-commit は ARGS を shlex.join で書くので、空白などを含むパスは引数全体（'--config=...'）が引用符で囲まれる。
    # その値を正しく取り出せないので、引用符を含む行は付け替えない。
    case "${args_line}" in
      *\'* | *\"*)
        warn "${hook} の ARGS に引用符が含まれていて --config を読み取れない。付け替えない。"
        continue
        ;;
    esac
    config="$(printf '%s' "${args_line}" | sed -n 's/.*--config=\([^ )]*\).*/\1/p')"
    if [ -z "${config}" ]; then
      warn "${hook} の --config を読み取れなかった。付け替えない。"
      continue
    fi
    allow=()
    case "${args_line}" in
      *--skip-on-missing-config*) allow=(--allow-missing-config) ;;
    esac
    if out="$(cd "${workdir}" && "${bin}" install -c "${config}" -t "${name}" "${allow[@]+"${allow[@]}"}" 2>&1)"; then
      echo "${workdir}: ${name} を ${have:-不明な版} から ${want} へ入れ直した。"
      gc_bin="${bin}"
    else
      warn "${workdir} の ${name} を入れ直せなかった: ${out}"
    fi
  done
  skipped=0
done 3<<<"${configs}"

if [ -n "${gc_bin}" ]; then
  "${gc_bin}" gc || warn "pre-commit gc が失敗した。"
else
  echo "mise で解決できる pre-commit が無かったので、pre-commit gc は実行しない。"
fi

# 入れ直した後のフックを読み直し、参照されている展開物のキャッシュキーを集める。
# INSTALL_PYTHON は shlex.quote 済みで引用符が付くことがあるので、パス全体ではなく「/<キー>/python」の部分で照合する。
referenced=""
while IFS= read -r hook; do
  [ -n "${hook}" ] || continue
  referenced+="$(sed -n 's/^INSTALL_PYTHON=//p' "${hook}")"$'\n'
done <<<"${found_hooks}"

shopt -s nullglob
removed=0
for dir in "${zipapp_root}"/*/; do
  dir="${dir%/}"
  key="$(basename "${dir}")"
  # 展開の途中にある一時ディレクトリは名前がキーと一致しないので、完成した展開物だけを対象にする。
  [ "$(cat "${dir}/CACHE_KEY" 2>/dev/null)" = "${key}" ] || continue
  if printf '%s' "${referenced}" | grep -Fq -- "/${key}/python"; then
    continue
  fi
  # 付け替える前から動いていたフックが、まだ旧版で実行中のことがある。
  if pgrep -f -- "/${key}/python" >/dev/null; then
    echo "${dir} は実行中のプロセスが使っているので、次回に回す。"
    continue
  fi
  version="$("${dir}/python" -mpre_commit --version 2>/dev/null)"
  if rm -rf "${dir}" && rm -f "${dir}.lock"; then
    echo "どのフックも参照していない展開物を削除した: ${key}（${version:-版不明}）"
    removed=$((removed + 1))
  else
    warn "${dir} を削除できなかった。"
  fi
done
[ "${removed}" -gt 0 ] || echo "削除する展開物は無かった。"
exit 0
