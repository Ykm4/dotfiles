{{/*
  Claude プロファイルの settings.json を生成する共通テンプレート。
  呼び出し側: {{ includeTemplate "claude-settings.json.tmpl" (dict "profileName" "<名前>" "root" .) }}
  注意: claude-settings-base.json もテンプレートとして実行される。中身に {{ を書かないこと。
*/ -}}
{{- $name := .profileName -}}
{{- $client := dict -}}
{{- if hasKey .root "clientProfiles" }}{{ $client = .root.clientProfiles }}{{ end -}}
{{- $p := get (merge (dict) .root.claudeProfiles $client) $name -}}
{{- /* 全プロファイル共通の宣言（claudeProfilesCommon）をプロファイル個別の前に連結する。
      marketplaces は name、plugins は id をキーに後勝ちのため、プロファイル側の再宣言が共通を上書きする。 */ -}}
{{- $common := dict "marketplaces" (list) "plugins" (list) -}}
{{- if hasKey .root "claudeProfilesCommon" }}{{ $common = mergeOverwrite $common .root.claudeProfilesCommon }}{{ end -}}
{{- $markets := dict -}}
{{- /* autoUpdate は宣言にあるときだけ設定する（settings.json の extraKnownMarketplaces.<name>.autoUpdate になる） */ -}}
{{- range concat $common.marketplaces $p.marketplaces }}{{ if eq .kind "github" }}{{ $m := dict "source" (dict "source" "github" "repo" .repo) }}{{ if hasKey . "autoUpdate" }}{{ $_ := set $m "autoUpdate" .autoUpdate }}{{ end }}{{ $_ := set $markets .name $m }}{{ end }}{{ end -}}
{{- $plugins := dict -}}
{{- range concat $common.plugins $p.plugins }}{{ $_ := set $plugins .id .enabled }}{{ end -}}
{{- $notify := "~/.config/claude/_shared/scripts/cmux-notify.sh" -}}
{{- /* 配備先のプロファイル構成（生成物）への直接編集を拒否し、dotfiles の正本へ誘導する */ -}}
{{- $denyGenerated := "~/.config/claude/_shared/scripts/deny-generated-config-edit.sh" -}}
{{- /* 秘密台帳から sandbox.credentials の deny リストを生成する（2026-08-30 露出インシデント対応）。
      enabled=false のまま配る: 手順[6]（漏れ経路の sentinel 検査後）で true へ切り替える。
      credentials.files は OS サンドボックス（Seatbelt）で Bash とその子の読み取りを拒否し、
      envVars は誤って親環境へ再導入された場合の保険として全秘密変数を unset する。 */ -}}
{{- $clientLedger := dict -}}
{{- if hasKey .root "clientSecretsLedger" }}{{ $clientLedger = .root.clientSecretsLedger }}{{ end -}}
{{- $ledger := merge (dict) .root.secretsLedger $clientLedger -}}
{{- $secretVars := list -}}
{{- range $prof, $svcs := $ledger }}{{ range $svc, $s := $svcs }}{{ range $s.vars }}{{ $secretVars = append $secretVars .name }}{{ end }}{{ end }}{{ end -}}
{{- $secretVars = concat $secretVars (list "FIRECRAWL_API_KEY" "GEMINI_API_KEY") | uniq | sortAlpha -}}
{{- $sandboxEnvVars := list -}}
{{- range $secretVars }}{{ $sandboxEnvVars = append $sandboxEnvVars (dict "name" . "mode" "deny") }}{{ end -}}
{{- $sandbox := dict
      "enabled" false
      "failIfUnavailable" true
      "credentials" (dict
        "files" (list (dict "path" "~/.config/secrets" "mode" "deny"))
        "envVars" $sandboxEnvVars)
-}}
{{- $base := includeTemplate "claude-settings-base.json" . | fromJson -}}
{{- $overlay := dict
      "permissions" (dict "additionalDirectories" (list
        (printf "~/%s/" $p.configDir)
        "~/.config/claude/_shared/"
        "~/.config/claude/_private/"
        "~/.agents/skills/"
        "~/.config/mise/"))
      "hooks" (dict
        "PreToolUse" (list (dict "matcher" "Edit|Write|NotebookEdit" "hooks" (list (dict "type" "command" "command" $denyGenerated "timeout" 10))))
        "Stop" (list (dict "matcher" "" "hooks" (list (dict "type" "command" "command" $notify "timeout" 10))))
        "Notification" (list (dict "matcher" "permission_prompt" "hooks" (list (dict "type" "command" "command" $notify "timeout" 10)))))
      "statusLine" (dict "type" "command" "command" "bun run ~/.config/claude/_shared/statusline.ts" "padding" 2)
      "extraKnownMarketplaces" $markets
      "enabledPlugins" $plugins
      "sandbox" $sandbox
-}}
{{- /* model と theme はプロファイル宣言にあるときだけ設定する。未指定なら既定に任せる。 */ -}}
{{- if hasKey $p "model" }}{{ $_ := set $overlay "model" $p.model }}{{ end -}}
{{- if hasKey $p "theme" }}{{ $_ := set $overlay "theme" $p.theme }}{{ end -}}
{{ mergeOverwrite $base $overlay | toPrettyJson }}
