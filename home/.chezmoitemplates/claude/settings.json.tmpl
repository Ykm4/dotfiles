    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/",
      "~/.config/claude/",
      "~/.agents/skills/",
      "~/.config/mise/"
    ]
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/_shared/scripts/cmux-notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/_shared/scripts/deny-generated-config-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claude/_shared/scripts/cmux-notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun run ~/.config/claude/_shared/statusline.ts",
    "padding": 2
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "diagram-design@diagram-design": true,
    "ponytail@ponytail": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
