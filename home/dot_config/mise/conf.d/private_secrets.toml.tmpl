# ============================================================
# Secrets (API keys, tokens)
# 値は chezmoi apply 時に 1Password (op://dotfiles/mise-secrets) から注入される。
# ============================================================

[env]
# 取引先関連シークレットは、注入されるパスの env ファイル (chmod 600) を参照
_.file = "{{ onepasswordRead "op://dotfiles/mise-secrets/client-env-path" }}"

# Context7 (MCP) — https://context7.com/dashboard
CONTEXT7_API_KEY = "{{ onepasswordRead "op://dotfiles/mise-secrets/context7-api-key" }}"
CONTEXT7_API_KEY_HUCOM_SYSTEM = "{{ onepasswordRead "op://hucomsystem/Context7 API Key hucom-system/credential" }}"

# MoneyForward クラウド会計 MCP (hucom プロファイル用)。URL 自体が社内エンドポイントのため 1Password で供給
MFC_CA_HUCOM_URL = "{{ onepasswordRead "op://dotfiles/mise-secrets/mfc-ca-hucom-url" }}"
