      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Bash(find * -exec *)",
      "Bash(find * -delete *)",
      "Bash(find * -execdir *)",
      "Bash(git push)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(gh api *merge*)",
      "Read(~/.config/*/env)",
      "Edit(~/.config/*/env)",
      "Bash(grep * ~/.config/*/env)",
      "Bash(rg * ~/.config/*/env)"
