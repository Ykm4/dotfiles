#!/usr/bin/env bash
#MISE description="gws と gcloud の認証状態をまとめて表示する（秘密は出さない）"
# 再認証が要るかどうかを1画面で判断するためのタスクである。
# gws 側の token_valid が false なら mise run google:auth <profile> を実行する。
set -uo pipefail

printf '=== gws（資格情報の正本）===\n'
for cfg in "${HOME}"/.config/gws/*/; do
  [ -d "${cfg}" ] || continue
  p=$(basename "${cfg}")
  out=$(GOOGLE_WORKSPACE_CLI_CONFIG_DIR="${cfg}" gws auth status 2>/dev/null | sed -n '/^{/,$p')
  if [ -z "${out}" ]; then
    printf '  %s\n    状態を取得できない（未設定のプロファイルである可能性がある）\n' "${p}"
    continue
  fi
  printf '%s' "${out}" | jq -r --arg p "${p}" '
    "  \($p)\n" +
    "    トークン: " + (if .token_valid then "有効" else "失効" end) +
    "  project: \(.project_id // "-")" +
    "  スコープ: \(.scope_count // 0)個" +
    (if (.token_error // "") != "" then "\n    error: \(.token_error)" else "" end)'
done

printf '\n=== gcloud（プロファイル別の設定ディレクトリ ~/.config/gcloud/<profile>）===\n'
# 所在の解決は conf.d/gcloud.toml にそろえる。
# 解決に失敗したときは「設定を読めない」ではなく、gcloud 自体が無いことを明示する。
gcloud_root="${GCLOUD_SDK_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/google-cloud-sdk}"
gcloud_cli="${gcloud_root}/bin/gcloud"
[ -x "${gcloud_cli}" ] || gcloud_cli="$(command -v gcloud || true)"
if [ -z "${gcloud_cli}" ] || [ ! -x "${gcloud_cli}" ]; then
  printf '  gcloud CLI が見つからない（chezmoi apply で導入する）\n'
else
  for cfg in "${HOME}"/.config/gws/*/; do
    p=$(basename "${cfg}")
    gdir="${HOME}/.config/gcloud/${p}"
    if [ ! -d "${gdir}" ]; then
      printf '  %s\n    未作成（mise run google:gcloud-login %s で作る）\n' "${p}" "${p}"
      continue
    fi
    acct=$(CLOUDSDK_CONFIG="${gdir}" "${gcloud_cli}" auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null || true)
    proj=$(CLOUDSDK_CONFIG="${gdir}" "${gcloud_cli}" config get-value project 2>/dev/null || true)
    printf '  %s\n    account: %s  project: %s\n' "${p}" "${acct:-未認証}" "${proj:-未設定}"
  done
  if [ -f "${HOME}/.config/gcloud/credentials.db" ]; then
    printf '  （旧共有ストア ~/.config/gcloud 直下に資格情報が残っている。全プロファイルの移行後に gcloud auth revoke で整理する）\n'
  fi
fi

printf '\n注記: gcloud は Claude Code の google-cloud-cli MCP（サーバ側実行）を通すため、ローカル gcloud の期限切れは直接使うときだけ関係する。\n'
printf 'ローカル gcloud の再認証は mise run google:gcloud-login <profile> を実行する。\n'
printf '再認証が要るときは mise run google:auth <profile> を実行する。\n'
