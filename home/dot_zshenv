# ------------------------------------
# 全zshセッション用環境変数 (対話的・非対話的セッション両方)
# ------------------------------------
# 以下の場面で利用可能なパスを定義:
# - 対話的シェル (ターミナル使用時)
# - 非対話的シェル (スクリプト実行、CI/CD)
# - package.jsonスクリプト実行
# - バックグラウンドプロセス

# JavaScript ツールチェーン管理 (mise)
# mise manages Node.js/pnpm versions with automatic switching

export CMUX_CUSTOM_CLAUDE_PATH="$HOME/.local/bin/claude"

# Claude Code native インストール（実体は ~/.local/bin/claude）を全セッションで PATH からも解決できるようにする
# .zshenv に置く理由: 対話的・非対話的（スクリプト・CI/CD・cmux 以外の起動）を問わず有効にするため
# ガードの理由: .zshenv はネストした zsh でも都度読まれるので、素の prepend だと PATH に重複が積み上がる
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# brew bundle --global の対象を ~/.Brewfile に固定（Homebrew 6 は ~/.homebrew/Brewfile を優先するため）
# （.chezmoiscripts/run_onchange_after_10-brew-bundle.sh.tmpl 内の同名 export と同期を保つ）
export HOMEBREW_BUNDLE_FILE_GLOBAL="$HOME/.Brewfile"

# homebrew-core の bottle のビルド来歴（provenance attestation）を gh で検証してからインストールする
# 対象は core formula の新規ダウンロードのみ（cask は対象外）。オフライン時は新規インストールが失敗する点に注意
export HOMEBREW_VERIFY_ATTESTATIONS=1

# lazygit の設定ファイルを XDG パスに固定する（macOS の既定は ~/Library/Application Support/lazygit で、~/.config は読まれない）
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

# 1Password CLI のデスクトップアプリ統合を有効にする
# アプリの 設定 > 開発者 で「1Password CLI と連携」にチェックが入っていても、この変数が未設定だと op が統合を認識せず `No accounts configured for use with 1Password CLI` で失敗する
# .zshenv に置く理由: 対話シェルからもスクリプト（chezmoi apply のテンプレート注入など）からも op を使うため
# 明示する理由: op は Homebrew cask、1Password アプリは自前の自動更新で独立に上がるため、明示しないとバージョンの組み合わせが変わるたびに再発しうる
export OP_BIOMETRIC_UNLOCK_ENABLED=true
