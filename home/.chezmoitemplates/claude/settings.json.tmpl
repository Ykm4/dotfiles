    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/secrets",
          "mode": "deny"
        }
      ],
      "envVars": {{ toJson $envVars }}
    },
    "enableWeakerNetworkIsolation": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
