#!/usr/bin/env bash
#MISE description="Claude Code の MCP をプロファイルごとに宣言どおり揃える（存在保証のみ）"
# 宣言は chezmoi の .chezmoidata/claude-profiles.toml。このファイルはそこから生成される。
# 契約: 必要項目の存在を保証する。名前が一致すれば URL・ヘッダの差異は検出しない。
# 満たせない項目は詳細を表示して非0で終わる。
set -euo pipefail

[ $# -eq 0 ] || { echo "未知の引数: $*" >&2; exit 2; }

command -v claude >/dev/null || { echo "claude CLI が無い" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq が無い" >&2; exit 1; }

rc=0

# personal は CLAUDE_CONFIG_DIR を設定しない。設定すると .claude.json が二重になる。
run_claude() {
  local explicit="$1" dir="$2"; shift 2
  if [ "$explicit" = "yes" ]; then
    CLAUDE_CONFIG_DIR="$dir" claude "$@"
  else
    env -u CLAUDE_CONFIG_DIR claude "$@"
  fi
}

{{- /* 公開の claudeProfiles と非公開の clientProfiles（client-dotfiles。無ければ空）を連結する */}}
{{- $client := dict }}
{{- if hasKey . "clientProfiles" }}{{ $client = .clientProfiles }}{{ end }}
{{- $all := merge (dict) .claudeProfiles $client }}
{{ range $name, $p := $all }}
{{- $explicit := "no" }}{{ if $p.explicitEnv }}{{ $explicit = "yes" }}{{ end }}
echo "=== {{ $name }} ==="
NAME="{{ $name }}"; DIR="$HOME/{{ $p.configDir }}"; EXPLICIT="{{ $explicit }}"
if [ ! -d "$DIR" ]; then
  echo "  設定ディレクトリが無い: $DIR" >&2; rc=1
else
{{- range $p.mcp }}
  MCP_URL="{{ if hasKey . "urlEnv" }}${{ "{" }}{{ .urlEnv }}:-{{ "}" }}{{ else }}{{ .url }}{{ end }}"
{{- if hasKey . "oauth" }}
{{- /* 事前登録 OAuth（DCR 非対応サーバ向け）。client_id/secret は環境変数で受け、secret は claude が keychain に保存する。認証自体は対話ターミナルでの claude mcp login が要る。 */}}
  MCP_CLIENT_ID="${{ "{" }}{{ .oauth.clientIdEnv }}:-{{ "}" }}"
  MCP_SECRET="${{ "{" }}{{ .oauth.clientSecretEnv }}:-{{ "}" }}"
  if [ -z "$MCP_URL" ] || [ -z "$MCP_CLIENT_ID" ] || [ -z "$MCP_SECRET" ]; then
    echo "  mcp skipped（URL または OAuth の環境変数が未設定）: {{ .name }}" >&2; rc=1
  elif run_claude "$EXPLICIT" "$DIR" mcp get "{{ .name }}" >/dev/null 2>&1; then
    echo "  mcp ok: {{ .name }}"
  else
    MCP_CLIENT_SECRET="$MCP_SECRET" run_claude "$EXPLICIT" "$DIR" mcp add-json --scope user "{{ .name }}" \
      "$(jq -cn --arg url "$MCP_URL" --arg cid "$MCP_CLIENT_ID" \
          '{type:"{{ .transport }}",url:$url,oauth:{clientId:$cid,callbackPort:{{ .oauth.callbackPort }},scopes:"{{ .oauth.scopes }}"}}')" \
      --client-secret \
      && echo "  mcp added: {{ .name }}（認証は対話ターミナルで claude mcp login {{ .name }} を実行する）" \
      || { echo "  mcp failed: {{ .name }}" >&2; rc=1; }
  fi
  unset MCP_SECRET
{{- else }}
  if [ -z "$MCP_URL" ]; then
    echo "  mcp skipped（URL の環境変数が未設定）: {{ .name }}" >&2; rc=1
  elif run_claude "$EXPLICIT" "$DIR" mcp get "{{ .name }}" >/dev/null 2>&1; then
    echo "  mcp ok: {{ .name }}"
  else
    run_claude "$EXPLICIT" "$DIR" mcp add --scope user --transport {{ .transport }} "{{ .name }}" "$MCP_URL" \
      {{ if hasKey . "header" }}--header '{{ .header }}'{{ end }} \
      && echo "  mcp added: {{ .name }}" \
      || { echo "  mcp failed: {{ .name }}" >&2; rc=1; }
  fi
{{- end }}
{{- end }}
fi
{{ end }}

if [ "$rc" -ne 0 ]; then
  echo "未完了または不一致の項目がある。認証後に mise run claude:restore を再実行すること" >&2
fi
exit "$rc"
