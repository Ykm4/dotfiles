{{- /*
  Claude Code の settings.json の基底（全プロファイル共通）。
  各プロファイルの modify_private_settings.json が claude/render-settings 経由でこれを読み、差分 JSON を重ねる。
  変更はこのファイル 1 か所で 3 プロファイルに届く。sandbox.credentials.envVars だけは秘密台帳から起こす。
*/ -}}
{{- $client := dict -}}
{{- if hasKey . "clientSecretsLedger" }}{{ $client = .clientSecretsLedger }}{{ end -}}
{{- $ledger := merge (dict) .secretsLedger $client -}}
{{- $names := list -}}
{{- range $p, $svcs := $ledger }}{{ range $svc, $s := $svcs }}{{ range $s.vars }}{{ $names = append $names .name }}{{ end }}{{ end }}{{ end -}}
{{- $envVars := list -}}
{{- range $names | uniq | sortAlpha }}{{ $envVars = append $envVars (dict "name" . "mode" "deny") }}{{ end -}}
{
  "cleanupPeriodDays": 20,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
