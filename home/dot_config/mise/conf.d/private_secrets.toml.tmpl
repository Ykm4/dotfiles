# ============================================================
# Secrets (API keys, tokens)
# 値は chezmoi apply 時に 1Password から注入される。
# プロファイル別の credential は所有者別 Vault（ykum4=personal・client-*=取引先・hucomsystem=自社）の
# API Credential 項目（フィールド credential）に置き、dotfiles 機構の値だけを dotfiles Vault の
# mise-secrets に置く。
# ============================================================

[env]
# 取引先関連シークレットは、注入されるパスの env ファイル (chmod 600) を参照
_.file = "{{ onepasswordRead "op://dotfiles/mise-secrets/client-env-path" }}"

# Context7 (MCP) — https://context7.com/dashboard
CONTEXT7_API_KEY = "{{ onepasswordRead "op://ykum4/Context7 API Key personal/credential" }}"
CONTEXT7_API_KEY_HUCOM_SYSTEM = "{{ onepasswordRead "op://hucomsystem/Context7 API Key hucom-system/credential" }}"

# Firecrawl (MCP + CLI) — https://www.firecrawl.dev/app/api-keys
# アカウントはプロファイル別（無印が personal。context7 と同じ流儀）。
# MCP は claude-profiles.toml のヘッダが、CLI は各作業ツリーの [env] / .envrc が参照する。
FIRECRAWL_API_KEY = "{{ onepasswordRead "op://ykum4/Firecrawl API Key personal/credential" }}"
FIRECRAWL_API_KEY_HUCOM = "{{ onepasswordRead "op://client-hucom/Firecrawl API Key hucom/credential" }}"
FIRECRAWL_API_KEY_HUCOM_SYSTEM = "{{ onepasswordRead "op://hucomsystem/Firecrawl API Key hucom-system/credential" }}"

# Google Developer Knowledge MCP（hucom-system プロファイル用）— https://developers.google.com/knowledge/mcp
# 検索 100/分・回答生成 50/日のプロジェクト別クォータ。キーは developerknowledge.googleapis.com だけに制限してある。
GOOGLE_DEV_KNOWLEDGE_API_KEY_HUCOM_SYSTEM = "{{ onepasswordRead "op://hucomsystem/Google Developer Knowledge API Key hucom-system/credential" }}"

# Google OAuth クライアント（hucomsystem-gws の Desktop 種別。gws CLI と Claude Code の Google リモート MCP が共用）。
# client_id は username、client_secret は credential。claude:restore が MCP 登録時に読む。
GOOGLE_OAUTH_CLIENT_ID_HUCOM_SYSTEM = "{{ onepasswordRead "op://hucomsystem/Google OAuth Client gws hucom-system/username" }}"
GOOGLE_OAUTH_CLIENT_SECRET_HUCOM_SYSTEM = "{{ onepasswordRead "op://hucomsystem/Google OAuth Client gws hucom-system/credential" }}"

# MoneyForward クラウド会計 MCP (hucom プロファイル用)。URL 自体が社内エンドポイントのため 1Password で供給
MFC_CA_HUCOM_URL = "{{ onepasswordRead "op://client-hucom/MFC CA URL hucom/credential" }}"
