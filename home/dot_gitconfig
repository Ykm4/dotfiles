[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Ykm4
	email = ykum4suke@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPAnTxCnV0LEohWxHFJqNLT5rG0Xy3B989xHCT7bapRz
[core]
	editor = vim -c \"set fenc=utf-8\"
	ignorecase = false
	quotepath = false
[pull]
	rebase = false
[color]
	diff = auto
	ui = true
	branch = auto
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
; 会社リポジトリのコミットを個人アドレスで記録しないための上書き。
; 末尾の / により配下すべてに再帰的に適用される。/i は macOS の
; 大文字小文字を区別しないパスでも取りこぼさないため。
; [user] より後に置くこと。後勝ちで上書きされる。
[includeIf "gitdir/i:~/work/hucom-system/"]
	path = ~/.config/git/config.d/hucom-system
